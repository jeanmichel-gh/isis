#!/usr/bin/env ruby
# frozen_string_literal: true

# Two IS instances on one in-memory wire, forming an IS-IS LAN adjacency
# and electing a DIS, with no privileges and no real interface, on the
# real clock. Watch them go down -> initializing -> up, elect b, and the
# log say why.
#
#   ruby -Ilib -I../datalink-socket/lib exe/isis-demo
#   ruby -Ilib -I../datalink-socket/lib exe/isis-demo --debug
#
$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
$LOAD_PATH.unshift File.expand_path("../../datalink-socket/lib", __dir__)

require "optparse"
require "isis4r"
require "datalink/backends/loopback"

opts = { log: "-", debug: false }
OptionParser.new do |o|
  o.banner = "usage: isis-demo [options]"
  o.on("-l", "--log FILE", "log and trace to FILE, - for standard output (default)") { |v| opts[:log] = v }
  o.on("-d", "--debug", "debug lines, and a trace of every PDU with its hex") { opts[:debug] = true }
end.parse!

out = opts[:log] == "-" ? $stdout : File.open(opts[:log], "a").tap { |f| f.sync = true }
clock = ISIS::Runtime::MonotonicClock.new

def log_for(out, clock, debug)
  ISIS::Runtime::Log.new(clock: clock, logger: ISIS::Runtime::Log.writer(out, clock: clock, debug: debug),
                         tracer: debug ? ISIS::Runtime::Log.trace_writer(out, clock: clock, debug: true) : nil)
end

wire = Datalink::Backends::Loopback::Wire.new

def socket(wire)
  Datalink::Socket.new("demo", backend: :loopback, wire: wire, recv_timeout: 0.1).open
end

a_sock = socket(wire)
b_sock = socket(wire)
scheduler = ISIS::Runtime::Scheduler.new(clock)

# Hellos every second, so the election runs two seconds in (RFC 1142
# 8.4.4 d). b has the higher priority, so b is DIS.
def lan(sock, scheduler, out, clock, opts, name, id, mac, priority)
  ISIS::LanCircuit.new(transport: ISIS::Link::SocketTransport.new(sock), scheduler: scheduler,
                       log: log_for(out, clock, opts[:debug]), name: name, system_id: id, snpa: mac,
                       priority: priority, hello_interval: 1)
end

a = lan(a_sock, scheduler, out, clock, opts, "a", "0000.0000.0001", "00:00:00:00:00:01", 64)
b = lan(b_sock, scheduler, out, clock, opts, "b", "0000.0000.0002", "00:00:00:00:00:02", 100)

puts "Starting two IS-IS instances on a shared LAN..."
[a, b].each(&:start)
done = lambda do
  a.up_neighbors.size == 1 && b.up_neighbors.size == 1 && b.dis? && a.dis.is_a?(ISIS::LanCircuit::Neighbor)
end
deadline = clock.now + 10
until done.call || clock.now > deadline
  scheduler.run_due
  [a, b].each { |c| c.poll(timeout: 0.05) }
end
[a, b].each(&:stop)

puts
puts "A (0000.0000.0001) sees B: #{a.neighbors.values.first&.state || :down}"
puts "B (0000.0000.0002) sees A: #{b.neighbors.values.first&.state || :down}"
puts "adjacency up both ways: #{a.up_neighbors.any? && b.up_neighbors.any?}"
puts "DIS: #{b.dis? ? 'b' : 'none'}, LAN ID #{a.lan_id_s} on both sides: #{a.lan_id_s == b.lan_id_s}"

a_sock.close
b_sock.close
